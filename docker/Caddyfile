{
	# Plain HTTP on 8080: TLS is terminated by a reverse proxy (see docs/self-hosting.md).
	admin off
	auto_https off
	frankenphp
}

:8080 {
	root * /app/public
	encode zstd br gzip

	# Vite emits content-hashed files under /build, so existing ones never change
	# (a missing file must not get the immutable header on its 404).
	@build {
		path /build/*
		file {
			try_files {path}
		}
	}
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
