APP_NAME=DBZuper
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DBZuper
# Directories SQLite connections may open (comma-separated; relative ones are relative to this directory).
DBZUPER_SQLITE_PATHS=storage/app/sqlite
DBZUPER_CONNECT_TIMEOUT=5
DBZUPER_INTROSPECTION_TIMEOUT=30
DBZUPER_QUERY_TIMEOUT=15
DBZUPER_SCHEMA_MAX_OBJECTS=5000
DBZUPER_HISTORY_KEEP=5000
# Account passwords in production: strong (default) or basic (8+ characters, no breach check; private installs only).
DBZUPER_PASSWORD_POLICY=strong

# Production (Docker image): see docs/self-hosting.md. The image sets APP_ENV=production, APP_DEBUG=false,
# LOG_CHANNEL=stderr, DB_DATABASE=/app/storage/database/database.sqlite and DBZUPER_SQLITE_PATHS=/data/sqlite,
# and generates APP_KEY into the storage volume when it is unset. Behind HTTPS also set APP_URL and SESSION_SECURE_COOKIE=true.

# Reverse proxies to trust for X-Forwarded-* headers (comma-separated IPs/CIDRs, or *). Unset: trust none.
TRUSTED_PROXIES=

# Engine test servers (used by `php artisan test`; see docker-compose.test.yml)
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=3307
TEST_MYSQL_USERNAME=root
TEST_MYSQL_PASSWORD=secret
TEST_MARIADB_HOST=127.0.0.1
TEST_MARIADB_PORT=3308
TEST_MARIADB_USERNAME=root
TEST_MARIADB_PASSWORD=secret
TEST_PGSQL_HOST=127.0.0.1
TEST_PGSQL_PORT=5432
TEST_PGSQL_USERNAME=postgres
TEST_PGSQL_PASSWORD=
